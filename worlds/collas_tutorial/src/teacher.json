{
    "machine": {
        "role": "teacher",
        "initial_state": "init",
        "msg": "Welcome to our tutorial at **CoLLAs 2026**!\nYour role: **teacher**",
        "options": {
            "highlight_blocking_states_in_messages": false,
            "show_action_ticks_after_messages": false,
            "show_action_request_after_messages": false
        }
    },
    "states": {
        "init": {
            "action": "reset_status",
            "action_kwargs": {},
            "msg": "Waiting for students...",
            "blocking": false,
            "time_to_wait_before_acting": 0.0
        },
        "in_class": {
            "action": null,
            "action_kwargs": {},
            "msg": "In class...",
            "blocking": false,
            "time_to_wait_before_acting": 0.0
        },
        "ready_for_lecture": {
            "action": null,
            "action_kwargs": {},
            "msg": "Ready for lecture...",
            "blocking": false,
            "time_to_wait_before_acting": 5.0
        },
        "lecture_in_progress": {
            "action": null,
            "action_kwargs": {},
            "msg": "Lecture in progress...",
            "blocking": true,
            "time_to_wait_before_acting": 0.0
        },
        "ready_for_exam": {
            "action": null,
            "action_kwargs": {},
            "msg": "Ready for the exam session...",
            "blocking": false,
            "time_to_wait_before_acting": 5.0
        },
        "exam_in_progress": {
            "action": null,
            "action_kwargs": {},
            "msg": "Exam in progress...",
            "blocking": true,
            "time_to_wait_before_acting": 0.0
        },
        "ready_for_feedback": {
            "action": null,
            "action_kwargs": {},
            "msg": "Ready to send requests...",
            "blocking": false,
            "time_to_wait_before_acting": 5.0
        },
        "feedback_time": {
            "action": null,
            "action_kwargs": {},
            "msg": "Waiting for feedback...",
            "blocking": true,
            "time_to_wait_before_acting": 0.0
        }
    },
    "transitions": {
        "init": [
            {
                "on": {
                    "action": "find_agents",
                    "action_kwargs": {
                        "role": "student",
                        "handshake_completed": true
                    },
                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "in_class"
            }
        ],
        "in_class": [
            {
                "on": {
                    "action": "give_next_lecture",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "ready_for_lecture"
            },
            {
                "on": {
                    "action": "start_exam_session",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "ready_for_exam"
            },
            {
                "on": {
                    "action": "ask_for_feedback",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "ready_for_feedback"
            }
        ],
        "ready_for_lecture": [
            {
                "on": {
                    "action": "teach",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "lecture_in_progress"
            }
        ],
        "lecture_in_progress": [
            {
                "on": {
                    "action": "lecture_finished",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "in_class"
            }
        ],
        "ready_for_exam": [
            {
                "on": {
                    "action": "hand_out_exam",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "exam_in_progress"
            }
        ],
        "exam_in_progress": [
            {
                "on": {
                    "action": "on_data",
                    "action_kwargs": {
                        "stream_group": "exam"
                    },
                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "exam_in_progress"
            },
            {
                "on": {
                    "action": "evaluate_results",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "in_class"
            }
        ],
        "ready_for_feedback": [
            {
                "on": {
                    "action": "send_requests",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "feedback_time"
            }
        ],
        "feedback_time": [
            {
                "on": {
                    "action": "on_data",
                    "action_kwargs": {
                        "stream_group": "feedback"
                    },
                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "feedback_time"
            },
            {
                "on": {
                    "action": "augment_lectures",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "init"
            }
        ]
    },
    "teleports": {}
}