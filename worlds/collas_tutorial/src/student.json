                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "in_class"
            }
        ],
        "in_class": [
            {
                "on": {
                    "action": "print",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": false,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "in_class"
            },
            {
                "on": {
                    "action": "learn",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": false,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 10.5,
                    "delay": 0.0
                },
                "goto": "done_learning"
            },
            {
                "on": {
                    "action": "process",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": false,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 15,
                    "delay": 0.0
                },
                "goto": "done_exam_or_feedback"
            }
        ],
        "wait_to_recover": [],
        "done_learning": [
            {
                "on": {
                    "action": "nop",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "in_class"
            }
        ],
        "done_exam_or_feedback": [
            {
                "on": {
                    "action": "nop",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "in_class"
            }
        ]
    },
    "teleports": {
        "teacher_found": [
            {
                "on": {
                    "action": "disconnected",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
