{
    "machine": {
        "role": "student",
        "initial_state": "init",
        "msg": "&#127891; Welcome to the world of Social Learning, you joined as a student",
        "options": {
            "highlight_blocking_states_in_messages": false,
            "show_action_ticks_after_messages": false,
            "show_action_request_after_messages": false
        }
    },
    "states": {
        "init": {
            "action": "clear_pending_requests",
            "action_kwargs": {
                "preserve": "get_engagement"
            },
            "msg": "&#9203; Waiting for the next set of lectures to start",
            "blocking": false,
            "time_to_wait_for_interactions": 0.0
        },
        "teacher_engaged": {
            "action": null,
            "action_kwargs": {},
            "msg": "&#128276; Ready for the lecture",
            "blocking": false,
            "time_to_wait_for_interactions": 0.0
        },
        "finished_learning": {
            "action": null,
            "action_kwargs": {},
            "msg": null,
            "blocking": true,
            "time_to_wait_for_interactions": 0.0
        },
        "listening_to_best_student": {
            "action": null,
            "action_kwargs": {},
            "msg": "&#128077; Ready to listen to the best student of the class",
            "blocking": false,
            "time_to_wait_for_interactions": 0.0
        }
    },
    "transitions": {
        "init": [
            {
                "on": {
                    "action": "get_engagement",
                    "action_kwargs": {
                        "acceptable_role": "teacher"
                    },
                    "msg": null,
                    "ready": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "time_to_wait_before_running": 0.0
                },
                "goto": "teacher_engaged"
            }
        ],
        "teacher_engaged": [
            {
                "on": {
                    "action": "do_learn",
                    "action_kwargs": {},
                    "msg": "&#128215; Following a lecture, learning...",
                    "ready": false,
                    "max_duration": 30.0,
                    "retry_timeout": 10.0,
                    "time_to_wait_before_running": 0.0
                },
                "goto": "finished_learning"
            },
            {
                "on": {
                    "action": "do_subscribe",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "time_to_wait_before_running": 0.0
                },
                "goto": "listening_to_best_student"
            },
            {
                "on": {
                    "action": "do_gen",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "time_to_wait_before_running": 0.0
                },
                "goto": "teacher_engaged"
            }
        ],
        "finished_learning": [
            {
                "on": {
                    "action": "do_gen",
                    "action_kwargs": {},
                    "msg": "&#9999;&#65039; Taking the exam...",
                    "ready": false,
                    "max_duration": 30.0,
                    "retry_timeout": 15.0,
                    "time_to_wait_before_running": 0.0
                },
                "goto": "teacher_engaged"
            }
        ],
        "listening_to_best_student": [
            {
                "on": {
                    "action": "do_learn",
                    "action_kwargs": {},
                    "msg": "&#128213; Learning from the best student&#8217;s feedback...",
                    "ready": false,
                    "max_duration": 30.0,
                    "retry_timeout": 9.9,
                    "time_to_wait_before_running": 0.0
                },
                "goto": "teacher_engaged"
            }
        ]
    },
    "teleports": {
        "all": [
            {
                "on": {
                    "action": "get_disengagement",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "time_to_wait_before_running": 0.0
                },
                "goto": "init"
            },
            {
                "on": {
                    "action": "disconnected",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": true,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "time_to_wait_before_running": 0.0
                },
                "goto": "init"
            },
            {
                "on": {
                    "action": "nop",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": true,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "time_to_wait_before_running": 30.0
                },
                "goto": "init"
            }
        ]
    }
}