{
  "machine": {
    "initial_state": "init",
    "msg": "🏫 Teacher agent started",
    "options": {
      "highlight_blocking_states_in_messages": false,
      "show_action_request_after_messages": false,
      "show_action_ticks_after_messages": false
    },
    "role": "teacher"
  },
  "states": {
    "brainstorm": {
      "action": "should_teach_or_evaluate",
      "action_kwargs": {},
      "blocking": true,
      "msg": "🤔 Deciding whether to teach or evaluate...",
      "time_to_wait_for_interactions": 0
    },
    "exam": {
      "action": "send_exam",
      "action_kwargs": {},
      "blocking": true,
      "msg": "📋 Preparing and sending exam to students...",
      "time_to_wait_for_interactions": 0
    },
    "init": {
      "action": null,
      "action_kwargs": {},
      "blocking": false,
      "msg": "🚀 Initializing teacher...",
      "time_to_wait_for_interactions": 0
    },
    "lesson": {
      "action": "init_lesson",
      "action_kwargs": {},
      "blocking": true,
      "msg": "📖 Preparing and sending lesson...",
      "time_to_wait_for_interactions": 0
    },
    "wait_lesson": {
      "action": null,
      "action_kwargs": {},
      "blocking": true,
      "msg": "⏳ Waiting for students to finish lesson...",
      "time_to_wait_for_interactions": 0
    },
    "wait": {
      "action": null,
      "action_kwargs": {},
      "blocking": true,
      "msg": "⏳ Waiting for connected students...",
      "time_to_wait_for_interactions": 0
    }
  },
  "teleports": {},
  "transitions": {
    "brainstorm": [
      {
        "goto": "lesson",
        "on": {
          "action": "building_lesson",
          "action_kwargs": {},
          "max_duration": 0,
          "msg": "📚 Building a new lesson...",
          "ready": true,
          "retry_timeout": 0,
          "time_to_wait_before_running": 0
        }
      },
      {
        "goto": "exam",
        "on": {
          "action": "building_evaluation",
          "action_kwargs": {},
          "max_duration": 0,
          "msg": "📝 Building an evaluation...",
          "ready": true,
          "retry_timeout": 0,
          "time_to_wait_before_running": 0
        }
      },
      {
        "goto": "brainstorm",
        "on": {
          "action": "should_teach_or_evaluate",
          "action_kwargs": {},
          "msg": "🔄 Re-evaluating next action...",
          "ready": true,
          "max_duration": 0,
          "retry_timeout": 0,
          "time_to_wait_before_running": 0
        }
      }
    ],
    "exam": [
      {
        "goto": "exam",
        "on": {
          "action": "get_samples",
          "action_kwargs": {},
          "max_duration": 0,
          "msg": "📊 Collecting student answers...",
          "ready": true,
          "retry_timeout": 0,
          "time_to_wait_before_running": 0
        }
      },
      {
        "goto": "wait",
        "on": {
          "action": "evaulate_exam",
          "action_kwargs": {},
          "max_duration": 0,
          "msg": "✅ Evaluating exam results...",
          "ready": true,
          "retry_timeout": 0,
          "time_to_wait_before_running": 0
        }
      }
    ],
    "init": [
      {
        "goto": "wait",
        "on": {
          "action": "nop",
          "action_kwargs": {
            "message": "None"
          },
          "max_duration": 0,
          "msg": "➡️ Teacher ready, moving to wait...",
          "ready": true,
          "retry_timeout": 0,
          "time_to_wait_before_running": 0
        }
      }
    ],
    "lesson": [
      {
        "goto": "wait_lesson",
        "on": {
          "action": "nop",
          "action_kwargs": {
            "message": "None"
          },
          "max_duration": 0,
          "msg": "🔄 Lesson sent, waiting for students to finish...",
          "ready": true,
          "retry_timeout": 0,
          "time_to_wait_before_running": 0
        }
      }
    ],
    "wait_lesson": [
      {
        "goto": "wait",
        "on": {
          "action": "check_lesson_finished",
          "action_kwargs": {},
          "max_duration": 0,
          "msg": null,
          "ready": true,
          "retry_timeout": 0,
          "time_to_wait_before_running": 0
        }
      }
    ],
    "wait": [
      {
        "goto": "brainstorm",
        "on": {
          "action": "welcoming",
          "action_kwargs": {},
          "max_duration": 0,
          "msg": null,
          "ready": true,
          "retry_timeout": 0,
          "time_to_wait_before_running": 0
        }
      }
    ]
  }
}
