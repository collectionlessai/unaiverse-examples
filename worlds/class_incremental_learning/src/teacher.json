{
    "machine": {
        "role": "teacher",
        "initial_state": "init",
        "msg": "🏫 Teacher agent started",
        "options": {
            "highlight_blocking_states_in_messages": false,
            "show_action_request_after_messages": false,
            "show_action_ticks_after_messages": false
        }
    },
    "states": {
        "init": {
            "action": null,
            "action_kwargs": {},
            "msg": "🚀 Initializing teacher...",
            "blocking": false,
            "time_to_wait_before_acting": 0.0
        },
        "wait_for_students": {
            "msg": "⏳ Waiting for students...",
            "blocking": false,
            "time_to_wait_before_acting": 0.0
        },
        "brainstorm": {
            "action": "should_teach_or_evaluate",
            "action_kwargs": {},
            "msg": "🤔 Deciding whether to teach or evaluate...",
            "blocking": false,
            "time_to_wait_before_acting": 0.0
        },
        "lesson": {
            "msg": "📖 Sending lesson to students...",
            "blocking": false,
            "time_to_wait_before_acting": 0.0
        },
        "lesson_in_progress": {
            "action": null,
            "action_kwargs": {},
            "msg": "⏳ Waiting for students to finish the lesson...",
            "blocking": true,
            "time_to_wait_before_acting": 0.0
        },
        "exam": {
            "msg": "📋 Sending exam to students...",
            "blocking": false,
            "time_to_wait_before_acting": 0.0
        },
        "exam_in_progress": {
            "action": null,
            "action_kwargs": {},
            "msg": "📊 Collecting student predictions...",
            "blocking": false,
            "time_to_wait_before_acting": 0.0
        },
        "scoring": {
            "msg": "✅ Scoring exam results...",
            "blocking": false,
            "time_to_wait_before_acting": 0.0
        }
    },
    "transitions": {
        "init": [
            {
                "on": {
                    "action": "nop",
                    "action_kwargs": {},
                    "msg": "➡️ Teacher ready",
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "wait_for_students"
            }
        ],
        "wait_for_students": [
            {
                "on": {
                    "action": "welcoming",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "brainstorm"
            }
        ],
        "brainstorm": [
            {
                "on": {
                    "action": "building_lesson",
                    "action_kwargs": {},
                    "msg": "📚 Will teach a new class.",
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "lesson"
            },
            {
                "on": {
                    "action": "building_evaluation",
                    "action_kwargs": {},
                    "msg": "📝 Will run an evaluation.",
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "exam"
            }
        ],
        "lesson": [
            {
                "on": {
                    "action": "init_lesson",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "lesson_in_progress"
            }
        ],
        "lesson_in_progress": [
            {
                "on": {
                    "action": "all_sent_completed",
                    "action_kwargs": {"action_name": "learn"},
                    "msg": "✅ Waiting for students to finish the lesson.",
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "wait_for_students"
            }
        ],
        "exam": [
            {
                "on": {
                    "action": "send_exam",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "exam_in_progress"
            }
        ],
        "exam_in_progress": [
            {
                "on": {
                    "action": "received_some_asked_data",
                    "action_kwargs": {"processing_fcn": "collect_predictions"},
                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "exam_in_progress"
            },
            {
                "on": {
                    "action": "all_sent_completed",
                    "action_kwargs": {"action_name": "process"},
                    "msg": "✅ Waiting for students to finish the exam...",
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "scoring"
            }
        ],
        "scoring": [
            {
                "on": {
                    "action": "score_exam",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "wait_for_students"
            }
        ]
    },
    "teleports": {}
}
