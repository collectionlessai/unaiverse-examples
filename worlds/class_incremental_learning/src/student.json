{
    "machine": {
        "role": "student",
        "initial_state": "init",
        "msg": "🎓 Student agent started",
        "options": {
            "highlight_blocking_states_in_messages": false,
            "show_action_request_after_messages": false,
            "show_action_ticks_after_messages": false
        }
    },
    "states": {
        "init": {
            "action": null,
            "action_kwargs": {},
            "msg": "🚀 Initializing student...",
            "blocking": false,
            "time_to_wait_before_acting": 0.0
        },
        "searching": {
            "action": null,
            "action_kwargs": {},
            "msg": "🔍 Searching for a teacher...",
            "blocking": true,
            "time_to_wait_before_acting": 5.0
        },
        "connected": {
            "action": null,
            "action_kwargs": {},
            "msg": "🤝 Connected to teacher, waiting for handshake...",
            "blocking": true,
            "time_to_wait_before_acting": 0.0
        },
        "wait": {
            "action": null,
            "action_kwargs": {},
            "msg": "⏳ Waiting for instructions from the teacher...",
            "blocking": true,
            "time_to_wait_before_acting": 0.0
        },
        "done_exam": {
            "action": null,
            "action_kwargs": {},
            "msg": "✅ Exam completed!",
            "blocking": false,
            "time_to_wait_before_acting": 0.0
        },
        "done_lesson": {
            "action": null,
            "action_kwargs": {},
            "msg": "📚 Lesson completed!",
            "blocking": false,
            "time_to_wait_before_acting": 0.0
        }
    },
    "transitions": {
        "init": [
            {
                "on": {
                    "action": "nop",
                    "action_kwargs": {},
                    "msg": "➡️ Looking for a teacher...",
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 5.0
                },
                "goto": "searching"
            }
        ],
        "searching": [
            {
                "on": {
                    "action": "connect_by_role",
                    "action_kwargs": {"role": "teacher"},
                    "msg": "🔗 Connecting to teacher...",
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 5.0,
                    "delay": 0.0
                },
                "goto": "connected"
            }
        ],
        "connected": [
            {
                "on": {
                    "action": "find_agents",
                    "action_kwargs": {"role": "teacher", "handshake_completed": true},
                    "msg": "✋ Handshake with teacher completed.",
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 5.0,
                    "delay": 0.0
                },
                "goto": "wait"
            }
        ],
        "wait": [
            {
                "on": {
                    "action": "process",
                    "action_kwargs": {},
                    "msg": "📝 Exam received, processing answers...",
                    "ready": false,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "done_exam"
            },
            {
                "on": {
                    "action": "learn",
                    "action_kwargs": {},
                    "msg": "🧠 Lesson received, learning...",
                    "ready": false,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "done_lesson"
            }
        ],
        "done_exam": [
            {
                "on": {
                    "action": "nop",
                    "action_kwargs": {},
                    "msg": "🔄 Back to waiting after exam.",
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "wait"
            }
        ],
        "done_lesson": [
            {
                "on": {
                    "action": "nop",
                    "action_kwargs": {},
                    "msg": "🔄 Back to waiting after lesson.",
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "wait"
            }
        ]
    },
    "teleports": {}
}
