{
    "machine": {
        "role": "service_provider",
        "initial_state": "ready",
        "msg": null,
        "options": {
            "highlight_blocking_states_in_messages": false,
            "show_action_ticks_after_messages": false,
            "show_action_request_after_messages": false
        }
    },
    "states": {
        "ready": {
            "action": "disengage_all",
            "action_kwargs": {},
            "msg": null,
            "blocking": true,
            "time_to_wait_before_acting": 0.0
        },
        "user_engaged": {
            "action": null,
            "action_kwargs": {},
            "msg": null,
            "blocking": true,
            "time_to_wait_before_acting": 0.0
        }
    },
    "transitions": {
        "ready": [
            {
                "on": {
                    "action": "engage",
                    "action_kwargs": {
                        "acceptable_role": "<user_role>"
                    },
                    "msg": null,
                    "ready": false,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "user_engaged"
            }
        ],
        "user_engaged": [
            {
                "on": {
                    "action": "process",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": false,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 0.0
                },
                "goto": "ready"
            }
        ]
    },
    "teleports": {
        "all": [
            {
                "on": {
                    "action": "nop",
                    "action_kwargs": {},
                    "msg": null,
                    "ready": true,
                    "high_priority": false,
                    "max_duration": 0.0,
                    "retry_timeout": 0.0,
                    "delay": 90.0
                },
                "goto": "ready"
            }
        ]
    }
}